{
  "mcpServers": {
    "agentvibes": {
      "command": "npx",
      "args": [
        "-y",
        "--package=agentvibes",
        "agentvibes-mcp-server"
      ],
      "disabled": false
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222"
      ]
    },
    "cloudflare-bindings": {
      "command": "sh",
      "args": [
        "-c",
        "npx mcp-remote https://bindings.mcp.cloudflare.com/mcp --header \"Authorization: Bearer $CLOUDFLARE_API_TOKEN\""
      ]
    },
    "cloudflare-observability": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://observability.mcp.cloudflare.com/mcp"
      ]
    }
  }
}
