{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foundry-engine-test",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],

  "ai": {
    "binding": "AI"
  },

  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "foundry-media-test"
    }
  ],

  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "foundry-embeddings-test"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "CLIENT_AGENT",
        "class_name": "ClientAgent"
      }
    ]
  },

  "vars": {
    "ENVIRONMENT": "test"
  }
}
