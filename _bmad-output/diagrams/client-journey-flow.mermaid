%% Client BrandDNA User Journey - Complete Flow Diagram
%% Generated by BMAD-TRACER - 2026-01-04

flowchart TD
    subgraph Email["📧 Email Phase"]
        A[Client Receives Email] --> B[Clicks 'Set Up My Brand Voice']
    end

    subgraph TokenValidation["🔐 Token Validation"]
        B --> C{Token Valid?}
        C -->|Not Found| D[❌ Show Invalid Link Error]
        C -->|Expired| E[⏰ Show Expiry Message]
        E --> F[🔄 Resend Option]
        C -->|Already Used| G[✓ Show Already Used Message]
        C -->|Valid| H[✅ Load BrandDNA Conversation]
    end

    subgraph PathChoice["🛤️ Path Selection"]
        H --> I[Welcome Message]
        I --> J{Choose Path?}
        J -->|Full Path<br/>10-15 min| K[Full Onboarding]
        J -->|Express Path<br/>2-3 min| L[Express Onboarding]
    end

    subgraph FullPath["📋 Full Path"]
        K --> K1[🎤 Voice Capture<br/>120s max]
        K1 --> K1a{Mic Permission?}
        K1a -->|Denied| K1b[Show Permission Guide]
        K1b --> K1c[Fallback: Type Response]
        K1a -->|Granted| K1d[Record Audio]
        K1c --> K2
        K1d --> K1e[🤖 Whisper Transcription]
        K1e --> K1f[🧠 Extract Personality<br/>LLaMA 3.1]
        K1f --> K2
        K2[📝 Brand Description] --> K3
        K3[👥 Audience Questions<br/>5 questions] --> K4
        K4[📱 Platform Selection<br/>2-4 platforms] --> K5
        K5[🏢 Competitor Input] --> K6
        K6[🎯 Pillar Generation<br/>AI generates 4] --> K7
        K7{Review Pillars?}
        K7 -->|Approve| K8[📊 Review Summary]
        K7 -->|Regenerate| K6
        K8 --> M[✅ Complete Session]
    end

    subgraph ExpressPath["⚡ Express Path"]
        L --> L1[🎤 Voice Capture<br/>60s max]
        L1 --> L1a{Mic Permission?}
        L1a -->|Denied| L1b[Fallback: Type]
        L1a -->|Granted| L1c[Record Audio]
        L1b --> L2
        L1c --> L1d[🤖 Whisper Transcription]
        L1d --> L2
        L2[📝 Express Brand Question] --> L3
        L3[👥 Express Audience Question] --> L4
        L4[📱 Express Platform Selection] --> M
    end

    subgraph Completion["🎉 Session Completion"]
        M --> N[💾 Save to ClientAgent DO]
        N --> O[📧 Mark Token Used]
        O --> P[📨 Notify Agency Owner]
    end

    subgraph AsyncResearch["🔬 Async Research (Background)"]
        P -.-> Q[🔍 Start Research Agent]
        Q --> Q1[🏭 Industry Detection]
        Q1 --> Q2[📊 Framework Analysis<br/>TEACH/ENTERTAIN/ENGINEER]
        Q2 --> Q3[🎯 Pillar Synthesis]
        Q3 --> Q4[📧 Send Strategy Email]
    end

    subgraph StrategyApproval["📝 Strategy Approval"]
        Q4 -.-> R[Client Clicks Strategy Link]
        R --> S{Strategy Token Valid?}
        S -->|Invalid/Expired| T[❌ Show Error]
        S -->|Already Locked| U[✓ Show Locked Status]
        S -->|Valid| V[Show Proposed Pillars]
        V --> W{Approve Pillars}
        W -->|Approve| X[✅ Mark Pillar Approved]
        W -->|Modify| Y[✏️ Modify Pillar]
        W -->|Get Alternatives| Z[🔄 Show Alternatives]
        X --> AA{3+ Pillars Approved?}
        Y --> W
        Z --> W
        AA -->|No| W
        AA -->|Yes| AB[🔒 Lock Strategy]
        AB --> AC[📨 Notify Agency: Strategy Locked]
    end

    subgraph PostCompletion["📦 Post-Completion"]
        AB -.-> AD[/"🎥 Private Win Video<br/>DESCOPED"/]
        AC -.-> AE[/"🗣️ Testimonial Request<br/>PARTIAL"/]
    end

    subgraph Legend["Legend"]
        direction LR
        LEG1[Standard Flow] --> LEG2[Completed ✅]
        LEG3[/"Descoped or Partial"/]
        LEG4[-.->] --> LEG5["Async/Background"]
    end

    %% Styling
    classDef completed fill:#90EE90,stroke:#228B22
    classDef partial fill:#FFD700,stroke:#FFA500
    classDef descoped fill:#FF6B6B,stroke:#DC143C
    classDef async fill:#87CEEB,stroke:#4169E1

    class M,N,O,P,AB,AC completed
    class AD,AE descoped
    class Q,Q1,Q2,Q3,Q4 async
